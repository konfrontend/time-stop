{
  "name": "@app/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@app/db": "*",
    "@app/domain": "*",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@app/eslint-config": "*",
    "@app/tsconfig": "*",
    "@types/node": "^24.13.3",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "uuid": "^14.0.2",
    "vitest": "^4.1.11"
  }
}
