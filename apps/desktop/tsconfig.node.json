{
  "extends": "@app/tsconfig/node.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "electron.vite.config.ts",
    "playwright.config.ts",
    "e2e",
    "src/main",
    "src/preload",
    "src/shared"
  ]
}
